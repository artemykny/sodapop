# syntax=docker/dockerfile:1.7

FROM golang:1.26.7-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/game-server ./cmd/oddoneout-server

FROM alpine:3.22

RUN apk add --no-cache ca-certificates && adduser -D -u 10001 sodapop
COPY --from=build /out/game-server /app/game-server

USER sodapop
ENV PORT=8081
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null "http://127.0.0.1:${PORT}/healthz" || exit 1
ENTRYPOINT ["/app/game-server"]
